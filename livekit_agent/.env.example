LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_AGENT_NAME=shipkia-voice-sales
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_VOICE=Puck
GEMINI_TEMPERATURE=0.65
CONFLUENCE_BASE_URL=http://127.0.0.1:8000
MCP_SERVER_URL=http://127.0.0.1:8000/api/method/confluence_ai.api.mcp.gateway
MCP_BEARER_TOKEN=token-key:token-secret
MCP_AUTH_HEADER=X-MCP-Token
CONFLUENCE_LIVEKIT_WEBHOOK_URL=http://127.0.0.1:8000/api/method/confluence_ai.api.webhook.receive_livekit
LIVEKIT_AGENT_MAX_CALL_SECONDS=900
LOG_LEVEL=INFO
